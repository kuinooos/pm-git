# ========================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ========================================

# LongCat LLM API
LONGCAT_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_MODEL=LongCat-2.0
LLM_TEMPERATURE=0

# Embedding 模型 (如遇下载慢可换 BAAI/bge-small-zh-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# Reranker 模型
RERANKER_MODEL=BAAI/bge-reranker-base

# LangSmith 链路追踪 (可选)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carbon-audit-agent

# ========================================
# Redis 缓存配置
# ========================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_RAG=3600
CACHE_TTL_EMISSION=1800
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ========================================
# JWT 认证配置
# ========================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# API 用户配置 (JSON 格式: {"username": "password", ...})
API_USERS={"admin": "admin123", "auditor": "audit456"}

# ========================================
# Celery 异步任务配置
# ========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
